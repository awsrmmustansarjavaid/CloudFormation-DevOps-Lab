# =======================================================
# TERRAFORM VARIABLES EXAMPLE
# =======================================================
#
# Copy this file to:
#
# terraform.tfvars
#
# Then change the values for your environment.
#
# IMPORTANT:
# Do NOT commit terraform.tfvars to Git.
# =======================================================


# =======================================================
# AWS
# =======================================================

aws_region = "us-east-1"


# =======================================================
# PROJECT
# =======================================================

project_name = "AWS-CloudFormation-Lab"

environment = "lab"


# =======================================================
# NETWORK
# =======================================================

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.4.0/24"
]

private_subnet_cidrs = [
  "10.0.2.0/24",
  "10.0.3.0/24"
]


# =======================================================
# EC2
# =======================================================
#
# Replace this with a valid Amazon Linux 2023 AMI ID
# for your selected AWS region.
# =======================================================

ami_id = "ami-xxxxxxxxxxxxxxxxx"

instance_type = "t3.micro"

# Replace with your existing EC2 Key Pair name.

key_pair_name = "YOUR-KEY-PAIR-NAME"


# =======================================================
# EC2 USERDATA
# =======================================================

userdata_script_url = "https://raw.githubusercontent.com/awsrmmustansarjavaid/CloudFormation-DevOps-Lab/main/scripts/ec2-userdata.sh"


# =======================================================
# S3
# =======================================================
#
# S3 bucket names must be globally unique.
#
# Leave this empty to let AWS/Terraform generate a name.
#
# Or provide something unique, for example:
#
# s3_bucket_name = "my-unique-lab-bucket-123456"
# =======================================================

s3_bucket_name = ""


# =======================================================
# RDS
# =======================================================

db_name = "labdb"

db_username = "admin"

db_instance_class = "db.t3.micro"

db_engine_version = "8.0"

db_allocated_storage = 20

db_backup_retention_period = 0

db_storage_encrypted = false

db_deletion_protection = false

# =========================================================
# AWS REGION
# =========================================================

aws_region = "us-east-1"


# =========================================================
# EC2
# =========================================================

instance_type = "t3.micro"

key_pair_name = "YOUR-KEY-PAIR"


# =========================================================
# RDS
# =========================================================

db_master_username = "admin"


# =========================================================
# S3 TEMPLATE BUCKET
# =========================================================
#
# Bucket used to store the CloudFormation nested-stack
# templates.
#
# IMPORTANT:
# S3 bucket names are globally unique.
#
# Replace this with your own unique bucket name.
#
# =========================================================

template_bucket_name = "cloudformation-devops-lab-YOUR-UNIQUE-ID"


# =========================================================
# EC2 USERDATA
# =========================================================
#
# URL of the EC2 bootstrap script.
#
# =========================================================

ec2_userdata_script_url = "https://raw.githubusercontent.com/awsrmmustansarjavaid/CloudFormation-DevOps-Lab/main/scripts/ec2-userdata.sh"

