# ============================================================
# Charlie Cafe
# Terraform Infrastructure
#
# File:
#   terraform.tfvars.example
#
# Purpose:
#   Example Terraform variable values for the Charlie Cafe
#   infrastructure.
#
# IMPORTANT:
#
#   This file is a TEMPLATE.
#
#   Copy this file to:
#
#       terraform.tfvars
#
#   and customize the values for your environment.
#
# ============================================================
#
# SECURITY:
#
# NEVER put the following into Git:
#
#   - AWS access keys
#   - AWS secret keys
#   - Database passwords
#   - API secrets
#   - Stripe secret keys
#   - Private tokens
#   - Other credentials
#
# Use AWS IAM, GitHub Actions Secrets, AWS Secrets Manager,
# environment variables, or another secure secret-management
# solution for sensitive values.
#
# ============================================================



# ============================================================
# 1. APPLICATION NAME
# ============================================================
#
# Main application/project name.
#
# This value is used for:
#
#   - Resource names
#   - Resource tags
#   - Security groups
#   - IAM roles
#   - ECS resources
#
# Keep this value consistent across the project.
#
# ============================================================

application_name = "CharlieCafe"



# ============================================================
# 2. AWS REGION
# ============================================================
#
# AWS region where the infrastructure will be deployed.
#
# Example:
#
#   ap-southeast-1
#   us-east-1
#   eu-west-1
#
# IMPORTANT:
#
# Your provider configuration should use this variable if
# your versions.tf/provider configuration is designed that way.
#
# ============================================================

aws_region = "ap-southeast-1"



# ============================================================
# 3. ECR REPOSITORY NAME
# ============================================================
#
# Name of the Amazon ECR repository.
#
# GitHub Actions will push the Docker image here.
#
# Expected image:
#
#   charlie-cafe:latest
#
# ============================================================

ecr_repository_name = "charlie-cafe"



# ============================================================
# 4. ECS CLUSTER NAME
# ============================================================
#
# Name of the ECS cluster.
#
# ============================================================

ecs_cluster_name = "CharlieCafe-Cluster"



# ============================================================
# 5. ECS SERVICE NAME
# ============================================================
#
# Name of the ECS Fargate service.
#
# ============================================================

ecs_service_name = "CharlieCafe-Service"



# ============================================================
# 6. ECS TASK FAMILY
# ============================================================
#
# ECS task definition family.
#
# Every new revision of the task definition belongs to this
# family.
#
# ============================================================

ecs_task_family = "CharlieCafe-Task"



# ============================================================
# 7. CONTAINER PORT
# ============================================================
#
# Port exposed by the Docker container.
#
# The Charlie Cafe Docker/Nginx application currently uses
# port 80 inside the container.
#
# Traffic flow:
#
#   Internet
#       |
#       v
#      ALB :80
#       |
#       v
#   ECS Container :80
#
# ============================================================

container_port = 80



# ============================================================
# 8. ECS TASK CPU
# ============================================================
#
# Fargate task CPU units.
#
# Current lab configuration:
#
#   256 CPU units
#
# This corresponds to:
#
#   0.25 vCPU
#
# ============================================================

task_cpu = 256



# ============================================================
# 9. ECS TASK MEMORY
# ============================================================
#
# Fargate task memory in MiB.
#
# Current lab configuration:
#
#   512 MiB
#
# The CPU/memory combination must be supported by AWS Fargate.
#
# ============================================================

task_memory = 512



# ============================================================
# 10. ECS DESIRED COUNT
# ============================================================
#
# Number of ECS tasks that the service should maintain.
#
# Recommended lab value:
#
#   1
#
# Production environments would normally use multiple tasks
# for high availability.
#
# ============================================================

ecs_desired_count = 1



# ============================================================
# OPTIONAL NETWORK VARIABLES
# ============================================================
#
# DO NOT add:
#
#   vpc_id
#   public_subnet_1_id
#   public_subnet_2_id
#   private_subnet_1_id
#   private_subnet_2_id
#   private_route_table_id
#
# to this file if network.tf creates those resources.
#
# ecs_ecr.tf now directly references:
#
#   aws_vpc.lab.id
#
#   aws_subnet.public[0].id
#   aws_subnet.public[1].id
#
#   aws_subnet.private[0].id
#   aws_subnet.private[1].id
#
#   aws_route_table.private.id
#
# This avoids duplicating networking configuration.
#
# ============================================================



# ============================================================
# END OF terraform.tfvars.example
# ============================================================
#
# After copying this file:
#
#   terraform.tfvars.example
#             |
#             v
#       terraform.tfvars
#
# Then customize the values.
#
# ============================================================