{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "RDSSecretsManagerAccess",
			"Effect": "Allow",
			"Action": [
				"secretsmanager:CreateSecret",
				"secretsmanager:DescribeSecret",
				"secretsmanager:TagResource",
				"secretsmanager:PutSecretValue"
			],
			"Resource": "*"
		},
		{
			"Sid": "RDSSecretsManagerKMSAccess",
			"Effect": "Allow",
			"Action": [
				"kms:DescribeKey",
				"kms:Encrypt",
				"kms:Decrypt",
				"kms:CreateGrant"
			],
			"Resource": "*"
		}
	]
}