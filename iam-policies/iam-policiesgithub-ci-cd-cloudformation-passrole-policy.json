{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassCharlieCafeCloudFormationRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::type-your-aws-id-here:role/CharlieCafe-CloudFormation-ServiceRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}